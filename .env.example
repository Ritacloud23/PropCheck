DATABASE_URL=postgresql+asyncpg://propcheck:propcheck@localhost:5434/propcheck
TEST_DATABASE_URL=postgresql+asyncpg://propcheck:propcheck@localhost:5434/propcheck_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FILE_SIGNING_SECRET=change-me-too
COOKIE_SECURE=false


CORS_ORIGINS=http://localhost:3000


API_PUBLIC_URL=http://localhost:8000


STORAGE_BACKEND=local
STORAGE_DIR=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack TEST MODE ONLY. Leave blank to use the built-in simulated payment provider.
# Keys that do not start with sk_test_/pk_test_ are refused at startup.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/renter/reservations

# States PropCheck serves (each must exist in backend/app/reference LOCATIONS)
ACTIVE_STATES=Lagos,Rivers,Enugu,Anambra,Imo
# Nearby places: default and maximum search radius in km
NEARBY_DEFAULT_RADIUS_KM=3
NEARBY_MAX_RADIUS_KM=10

# Rate limiting (see docs/RATE_LIMITING.md). Rates are "<count>/<second|minute|hour|day>".
RATE_LIMIT_ENABLED=true
# Shared counters. REQUIRED in production with more than one API instance, e.g. redis://redis:6379/0.
# Empty = in-memory development fallback (one process only, resets on restart).
REDIS_URL=
# Proxies whose X-Forwarded-For header is trusted (IPs or CIDRs), e.g. the Next.js server.
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_LOGIN_IP=30/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_PASSWORD_RESET=3/hour
RATE_LIMIT_PROPERTY_SEARCH=60/minute
RATE_LIMIT_NEARBY_SEARCH=60/minute
RATE_LIMIT_HOUSE_SEARCH=5/hour
RATE_LIMIT_REPORTS=5/hour
RATE_LIMIT_UPLOADS=20/hour
RATE_LIMIT_RESERVATIONS=10/minute

# ---------- Frontend (Next.js) ----------

API_INTERNAL_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000
