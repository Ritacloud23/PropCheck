# ---------- Backend (FastAPI) ----------
# Docker Compose maps Postgres to host port 5434 (5432/5433 are often taken locally).
DATABASE_URL=postgresql+psycopg://propcheck:propcheck@localhost:5434/propcheck
TEST_DATABASE_URL=postgresql+psycopg://propcheck:propcheck@localhost:5434/propcheck_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FILE_SIGNING_SECRET=change-me-too
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Public base URL of the API (used to build media URLs)
API_PUBLIC_URL=http://localhost:8000

# Storage: "local" (default) or "cloudinary" (public photos only; documents always stay private/local)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack TEST MODE ONLY. Leave blank to use the built-in simulated payment provider.
# Keys that do not start with sk_test_/pk_test_ are refused at startup.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/renter/reservations

# States PropCheck serves (each must exist in backend/app/reference LOCATIONS)
ACTIVE_STATES=Lagos,Rivers,Enugu,Anambra,Imo
# Nearby places: default and maximum search radius in km
NEARBY_DEFAULT_RADIUS_KM=3
NEARBY_MAX_RADIUS_KM=10

# Basic in-memory rate limit for auth endpoints (requests per minute per IP)
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---------- Frontend (Next.js) ----------
# Server-side URL the Next.js server uses to reach the API (inside Docker: http://api:8000)
API_INTERNAL_URL=http://localhost:8000

# Public site URL (used for share links)
FRONTEND_URL=http://localhost:3000
